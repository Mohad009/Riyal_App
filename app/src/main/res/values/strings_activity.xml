    <string name="activity_settings_title">Settings</string>
    <string name="activity_your_money">Your money</string>
    <string name="activity_default_currency">Default currency</string>
    <string name="activity_currency_help">Used when a message doesn\'t name a currency. OMR amounts keep 3 decimals (baisa).</string>
    <string name="activity_bank_accounts">Bank accounts</string>
    <string name="activity_accounts_help">The accounts read out of your bank\'s own messages, their balances and which sender belongs to which.</string>
    <string name="activity_categories">Categories</string>
    <string name="activity_categories_help">Every category and what it cost, where your own are made - and the names Riyal has learned: the ones it files without asking, and the ones you asked to be asked about every time.</string>
    <string name="activity_budget">Budget</string>
    <string name="activity_budget_help">Home gains a budget section for the month it is showing: a cap per category, a bar for each, and a marker for whether the money is going faster than the calendar. A plan can cover any period, set from its editor.</string>
    <string name="activity_sms_permission">SMS permission</string>
    <string name="activity_permission_help">Reading SMS is the only runtime permission Riyal asks you to grant. It has no background SMS receiver. Internet access is used only to check for and download updates from GitHub; your messages and financial records stay on your device.</string>
    <string name="activity_manage">Manage</string>
    <string name="activity_scan_on_launch">Scan when the app opens</string>
    <string name="activity_scan_on_launch_help">Riyal reads the inbox once when it starts. With this off, a scan only happens when you pull down to refresh.</string>
    <string name="activity_how_far_back">How far back</string>
    <string name="activity_how_far_back_help">How far back a scan looks. Messages outside the range are not even queried from the inbox.</string>
    <string name="activity_read_older">Read older messages too</string>
    <string name="activity_log_fresh_start">fresh start lifted, older messages can be read again</string>
    <string name="activity_gate_keywords">Gate keywords</string>
    <string name="activity_gate_keywords_help">A message is processed only if it contains one of these words. Everything else is skipped, unread and unstored.</string>
    <string name="activity_money_out">Money out</string>
    <string name="activity_money_in">Money in</string>
    <string name="activity_log_keywords_reset">keywords reset to defaults (withdraw/debited/purchase… + deposit/credited/salary… incl. Arabic)</string>
    <string name="activity_reset_defaults">Reset to defaults</string>
    <string name="activity_who_is_read">Who is read</string>
    <string name="activity_who_is_read_help">Two filters over the sender name, on top of the gate keywords. Banks that don\'t brand themselves as banks (NBO, Sohar Intl, Meethaq) are approved by name in the list instead.</string>
    <string name="activity_bank_senders_only">Bank senders only</string>
    <string name="activity_bank_senders_help">Only senders whose name contains “bank”, “بنك” or “مصرف” are read. Anything else has to be approved by name below.</string>
    <string name="activity_approved_only">Only senders I approve</string>
    <string name="activity_approved_only_help">With this off, every sender is considered and the message body still has to contain one of the gate keywords to be read at all.</string>
    <string name="activity_approved_empty">No approved senders yet, a scan will match nothing.</string>
    <string name="activity_extra_approved_empty">No extra approved senders, only bank-named senders are read.</string>
    <string name="activity_sender_name">Sender name</string>
    <string name="activity_sender_suggestions">Seen in your inbox, tap to approve:</string>
    <string name="activity_scan_now">Scan now</string>
    <string name="activity_rescan_all">Rescan everything</string>
    <string name="activity_rescan">Rescan</string>
    <string name="activity_automation">Automation</string>
    <string name="activity_learn_corrections">Learn from my corrections</string>
    <string name="activity_learn_corrections_help">When you fix a category on a transaction with a merchant, that merchant is remembered and applied to past and future messages. The category picker still lets you opt out for a single edit, and a name marked “ask every time” is never remembered at all.</string>
    <string name="activity_confirm_transfers">Confirm transfers for me</string>
    <string name="activity_confirm_transfers_help">A matching pair is the same amount and currency, moving between two of your own accounts, minutes apart. With this on it becomes one transfer straight away and stops counting as spending or income; any of them can be split back apart from its row in Activity. With it off, every pair waits in Review for your yes or no.</string>
    <string name="activity_your_data">Your data</string>
    <string name="activity_export_transactions">Export transactions</string>
    <string name="activity_export_help">Writes every record to a CSV file you choose: date, type, amount, accounts, merchant, category and the message it was read from.</string>
    <string name="activity_export">Export</string>
    <string name="activity_verbose_log">Verbose log</string>
    <string name="activity_verbose_value">every step, in plain words</string>
    <string name="activity_verbose_help">Everything the scanner did and why, written as it happens. It never leaves the phone unless you copy it out yourself.</string>
    <string name="activity_log_copied">verbose log copied to clipboard</string>
    <string name="activity_copy">Copy</string>
    <string name="activity_log_cleared">log cleared by you</string>
    <string name="activity_clear">Clear</string>
    <string name="activity_storage_title">Where it lives</string>
    <string name="activity_storage_value">this phone only</string>
    <string name="activity_storage_help">Everything lives in one JSON file inside this app\'s private storage, and backups are disabled. The app does reach the network, for one thing: it asks GitHub whether a newer release exists, and downloads that APK if you ask it to. Nothing goes the other way. No record, message, account or figure is ever put in a request, and there is no analytics and no backend.</string>
    <string name="activity_about">About</string>
    <string name="activity_brand">Riyal</string>
    <string name="activity_checking_ellipsis">checking…</string>
    <string name="activity_update_download_help">Downloading puts the APK in your Downloads folder and opens it there. Riyal cannot install it for you - you tap the file yourself. If Android refuses the install, that build is signed with a different key than this one: uninstall Riyal first, which clears its stored records. They rebuild from your inbox on the next scan, but hand-filed categories do not.</string>
    <string name="activity_update_unreachable_help">The last check could not reach GitHub. Being offline, a rate limit and a release that was never published all look the same from here. Nothing is wrong with the copy you have; tap Check now to try again.</string>
    <string name="activity_about_help">Made for Oman 🇴🇲 · OMR-first, with Arabic SMS support. Checks GitHub once a day for a newer release.</string>
