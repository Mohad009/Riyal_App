    <string name="activity_settings_title">الإعدادات</string>
    <string name="activity_your_money">أموالك</string>
    <string name="activity_default_currency">العملة الافتراضية</string>
    <string name="activity_currency_help">تُستخدم عندما لا تذكر الرسالة العملة. تُعرض مبالغ الريال العُماني بثلاث خانات عشرية للحفاظ على قيمة البيسة.</string>
    <string name="activity_bank_accounts">الحسابات البنكية</string>
    <string name="activity_accounts_help">الحسابات المستخرجة من رسائل البنك، وأرصدتها، والمرسل المرتبط بكل حساب.</string>
    <string name="activity_categories">الفئات</string>
    <string name="activity_categories_help">تجد هنا الفئات ومصروفات كل منها، وتُنشئ فئاتك الخاصة، وتراجع أسماء التجار التي تعلّمها ريال، سواء التي يصنّفها تلقائيًا أو التي طلبت مراجعتها في كل مرة.</string>
    <string name="activity_budget">الميزانية</string>
    <string name="activity_budget_help">تظهر الميزانية في الرئيسية للشهر المعروض، مع حد إنفاق ومؤشر لكل فئة، وتنبيه إذا كان الإنفاق أسرع من مرور الأيام. يمكنك تحديد أي فترة للميزانية من شاشة تعديلها.</string>
    <string name="activity_sms_permission">إذن قراءة الرسائل</string>
    <string name="activity_permission_help">قراءة الرسائل هي الإذن الوحيد الذي يطلب ريـال منك منحه أثناء الاستخدام. لا يقرأ الرسائل في الخلفية. يستخدم الإنترنت فقط للتحقق من تحديثاته وتنزيلها من GitHub؛ وتبقى رسائلك وبياناتك المالية على جهازك.</string>
    <string name="activity_manage">إدارة</string>
    <string name="activity_scan_on_launch">قراءة الرسائل عند فتح التطبيق</string>
    <string name="activity_scan_on_launch_help">يقرأ ريال الرسائل مرة واحدة عند فتحه. إذا عطّلت هذا الخيار، تبدأ القراءة عندما تسحب لأسفل للتحديث.</string>
    <string name="activity_how_far_back">فترة قراءة الرسائل</string>
    <string name="activity_how_far_back_help">الفترة التي تشملها قراءة الرسائل. لا يبحث التطبيق في الرسائل الأقدم من الفترة المحددة.</string>
    <string name="activity_read_older">قراءة الرسائل الأقدم أيضًا</string>
    <string name="activity_log_fresh_start">أُزيل تاريخ البدء، ويمكن قراءة الرسائل الأقدم مجددًا</string>
    <string name="activity_gate_keywords">الكلمات التي تحدد الرسائل المالية</string>
    <string name="activity_gate_keywords_help">تُعالج الرسالة فقط إذا احتوت على إحدى هذه الكلمات. وتُتجاهل بقية الرسائل دون قراءتها أو حفظها.</string>
    <string name="activity_money_out">المصروفات</string>
    <string name="activity_money_in">الدخل</string>
    <string name="activity_log_keywords_reset">استُعيدت الكلمات المالية الافتراضية للمصروفات والدخل، بما فيها الكلمات العربية</string>
    <string name="activity_reset_defaults">استعادة الإعدادات الافتراضية</string>
    <string name="activity_who_is_read">المرسلون المشمولون بالقراءة</string>
    <string name="activity_who_is_read_help">يُطبّق عاملان لتصفية أسماء المرسلين إضافةً إلى الكلمات المالية. أضف أسماء البنوك التي لا يتضمن اسم مرسلها كلمة بنك، مثل NBO وSohar Intl وMeethaq، إلى قائمة المرسلين المعتمدين.</string>
    <string name="activity_bank_senders_only">مرسلو البنوك فقط</string>
    <string name="activity_bank_senders_help">تُقرأ الرسائل إذا احتوى اسم مرسلها على «bank» أو «بنك» أو «مصرف». ويجب اعتماد أي مرسل آخر باسمه أدناه.</string>
    <string name="activity_approved_only">المرسلون الذين أعتمدهم فقط</string>
    <string name="activity_approved_only_help">عند تعطيل هذا الخيار، يشمل البحث جميع المرسلين، لكن يجب أن تحتوي الرسالة على إحدى الكلمات المالية حتى تُقرأ.</string>
    <string name="activity_approved_empty">لم تعتمد أي مرسل بعد، لذا لن تجد القراءة رسائل مطابقة.</string>
    <string name="activity_extra_approved_empty">لا يوجد مرسلون إضافيون معتمدون. تُقرأ فقط رسائل المرسلين الذين يتضمن اسمهم كلمة بنك.</string>
    <string name="activity_sender_name">اسم المرسل</string>
    <string name="activity_sender_suggestions">مرسلون موجودون في رسائلك. اضغط على الاسم لاعتماده:</string>
    <string name="activity_scan_now">قراءة الرسائل الآن</string>
    <string name="activity_rescan_all">إعادة قراءة جميع الرسائل</string>
    <string name="activity_rescan">إعادة القراءة</string>
    <string name="activity_automation">الإجراءات التلقائية</string>
    <string name="activity_learn_corrections">التعلّم من تعديلاتي</string>
    <string name="activity_learn_corrections_help">عندما تغيّر فئة معاملة لها اسم تاجر، يتذكر ريال الاسم ويطبّق الفئة على معاملاته السابقة واللاحقة. يمكنك إيقاف التذكّر لهذا التعديل من اختيار الفئة. ولا يتذكر التطبيق الأسماء التي اخترت مراجعتها في كل مرة.</string>
    <string name="activity_confirm_transfers">تأكيد التحويلات تلقائيًا</string>
    <string name="activity_confirm_transfers_help">يتطابق زوج المعاملات عندما يتساوى المبلغ والعملة ويكون التحويل بين حسابين لك خلال دقائق. عند تفعيل هذا الخيار، يُجمع الزوج فورًا في تحويل واحد ولا يُحسب ضمن المصروفات أو الدخل. يمكنك فصل المعاملتين من قائمة المعاملات. وعند تعطيله، تنتظر كل حالة قرارك في شاشة المراجعة.</string>
    <string name="activity_your_data">بياناتك</string>
    <string name="activity_export_transactions">تصدير المعاملات</string>
    <string name="activity_export_help">يحفظ جميع المعاملات في ملف CSV تختار مكانه، ويتضمن التاريخ والنوع والمبلغ والحسابات والتاجر والفئة والرسالة الأصلية.</string>
    <string name="activity_export">تصدير</string>
    <string name="activity_verbose_log">السجل التفصيلي</string>
    <string name="activity_verbose_value">كل خطوة بلغة واضحة</string>
    <string name="activity_verbose_help">يوثّق كل ما تفعله قراءة الرسائل وسببه لحظة حدوثه. ويبقى على الهاتف ما لم تنسخه بنفسك.</string>
    <string name="activity_log_copied">نُسخ السجل التفصيلي إلى الحافظة</string>
    <string name="activity_copy">نسخ</string>
    <string name="activity_log_cleared">مُسح السجل بطلبك</string>
    <string name="activity_clear">مسح</string>
    <string name="activity_storage_title">مكان حفظ البيانات</string>
    <string name="activity_storage_value">على هذا الهاتف فقط</string>
    <string name="activity_storage_help">تُحفظ البيانات في ملف JSON واحد داخل مساحة التطبيق الخاصة، والنسخ الاحتياطي معطّل. يتصل التطبيق بالشبكة للتحقق من وجود إصدار أحدث على GitHub، وينزّل ملف APK إذا طلبت ذلك. لا يرسل معاملاتك أو رسائلك أو حساباتك أو أرقامك في أي طلب، ولا يستخدم خدمة لتحليل الاستخدام أو خادمًا لحفظ بياناتك.</string>
    <string name="activity_about">حول التطبيق</string>
    <string name="activity_brand">ريال</string>
    <string name="activity_checking_ellipsis">جارٍ التحقق…</string>
    <string name="activity_update_download_help">يُحفظ ملف APK في مجلد التنزيلات ويُفتح من هناك. اضغط على الملف بنفسك لتثبيته. إذا رفض Android التثبيت لأن الإصدار موقّع بمفتاح مختلف، فستحتاج إلى إلغاء تثبيت ريال أولًا، مما يحذف بياناته المحفوظة. تُعاد المعاملات من رسائلك عند القراءة التالية، لكن التصنيفات التي أدخلتها يدويًا لا تُستعاد.</string>
    <string name="activity_update_unreachable_help">تعذّر الاتصال بـ GitHub في آخر محاولة. قد يكون السبب انقطاع الاتصال، أو بلوغ حد الطلبات، أو عدم نشر إصدار. لا يعني ذلك وجود مشكلة في إصدارك الحالي. اضغط على «التحقق الآن» للمحاولة مجددًا.</string>
    <string name="activity_about_help">صُمّم لعُمان 🇴🇲، مع أولوية للريال العُماني ودعم الرسائل العربية. يتحقق من إصدار أحدث على GitHub مرة يوميًا.</string>
